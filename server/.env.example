# Copy to .env and fill in. Both secrets must be set in production: without
# them the server generates fresh ones each start, which logs out every admin
# and invalidates every device credential.
#   openssl rand -base64 32
BIPBOX_SESSION_SECRET=
BIPBOX_DEVICE_SECRET_PEPPER=

# Read-only token for /health/detail, used by Uptime Kuma. Leave empty to
# disable those endpoints rather than expose them.
BIPBOX_MONITOR_TOKEN=

# off | wireguard | plain_rtp   (architecture.md §6.4)
BIPBOX_BROWSER_VOIP_MODE=wireguard
BIPBOX_WG_SUBNET=100.64.42.0/24
