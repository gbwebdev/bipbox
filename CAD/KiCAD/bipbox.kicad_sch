	(text "Red LED: power\nSmall low-energy green-LED: RPi activity\nBlue LED:\n  - off: wifi down\n  - slow blink: looking for wifi\n  - . . _ .. _ : hotspot mode\n  - quick blink: connecting to wifi\n  - steady: wifi connected\nGreen LED 1:\n  - off: telex client down\n  - slow blink: connecting to telex server\n  - quick blink: receiving telex / waiting to print\nGreen LED 2:\n  - off: VOip client down\n  - slow blink: connecting to VOip server\n  - quick blink: receiving communication\n  - steady: broadcasting\nYellow LED: Telegraphy"
		(exclude_from_sim no)
		(at 71.628 178.308 0)
		(effects
			(font
				(size 0.762 0.762)
			)
			(justify left)
		)
		(uuid "dad92173-8bfb-4f07-ba38-0f6d972ce3cb")
	)
